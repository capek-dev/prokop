  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^2.0.35",
    "@ai-sdk/openai": "^3.0.84",
    "@capekai/tool": "^1.0.0",
    "@capekai/types": "^1.0.1",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@zip.js/zip.js": "^2.7.60",
    "ai": "^6.0.116",
    "ignore": "^7.0.3",
    "picomatch": "^4.0.2",
    "tar": "^7.5.13",
    "vercel-minimax-ai-provider": "^0.0.2",
    "zhipu-ai-provider": "^0.2.2"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "@types/picomatch": "^4.0.1",
    "@types/tar": "^7.0.87",
    "bun-types": "^1.3.9",
    "typescript": "^5.7.2"
  }
