      "default": "./src/internal/composition.ts"
    },
    "./plugins": {
      "types": "./src/internal/plugins.ts",
      "default": "./src/internal/plugins.ts"
    },
    "./hosts": {
      "types": "./src/internal/hosts.ts",
      "default": "./src/internal/hosts.ts"
    },
    "./execution": {
      "types": "./src/internal/execution.ts",
      "default": "./src/internal/execution.ts"
    },
    "./providers": {
      "types": "./src/internal/providers.ts",
      "default": "./src/internal/providers.ts"
    },
    "./tools": {
      "types": "./src/internal/tools.ts",
      "default": "./src/internal/tools.ts"
    },
    "./ask-authority": {
      "types": "./src/internal/ask-authority.ts",
      "default": "./src/internal/ask-authority.ts"
    },
    "./sandbox": {
      "types": "./src/internal/sandbox.ts",
      "default": "./src/internal/sandbox.ts"
    },
    "./workspace": {
      "types": "./src/internal/workspace.ts",
      "default": "./src/internal/workspace.ts"
    },
    "./configuration": {
      "types": "./src/internal/configuration.ts",
      "default": "./src/internal/configuration.ts"
    },
    "./tool": {
      "types": "./src/tool.ts",
      "default": "./src/tool.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./src/storage.ts"
    }
