{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["bun-types", "node"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"],
      "#tests/*": ["./tests/*"],
      "#package": ["./package.json"]
    }
  },
  "include": ["../src/**/*", "./**/*"]
}
