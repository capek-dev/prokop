{
  "name": "@prokopai/sdk",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {},
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/shared.ts",
      "default": "./src/shared.ts"
    },
    "./types/*": {
      "types": "./src/shared-types/*.ts",
      "default": "./src/shared-types/*.ts"
    },
    "./tool": {
      "types": "./src/shared-types/tool.ts",
      "default": "./src/shared-types/tool.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/add-js-extensions.ts",
    "typecheck": "tsc --noEmit",
    "version:sync": "echo \"export const version: string = '$npm_package_version';\" > src/version.ts"
  }
}
