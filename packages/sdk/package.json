{
  "name": "@prokopai/sdk",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {
    "@capekai/tool": "^1.0.1",
    "@capekai/types": "^1.0.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun scripts/add-js-extensions.ts",
    "typecheck": "tsc --noEmit",
    "version:sync": "echo \"export const version: string = '$npm_package_version';\" > src/version.ts"
  }
}
