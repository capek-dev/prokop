{
  "name": "@capekai/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./message": { "types": "./src/message.ts", "default": "./src/message.ts" },
    "./session": { "types": "./src/session.ts", "default": "./src/session.ts" },
    "./preconfig": { "types": "./src/preconfig.ts", "default": "./src/preconfig.ts" },
    "./model": { "types": "./src/model.ts", "default": "./src/model.ts" },
    "./workspace": { "types": "./src/workspace.ts", "default": "./src/workspace.ts" },
    "./permission": { "types": "./src/permission.ts", "default": "./src/permission.ts" },
    "./interrupt": { "types": "./src/interrupt.ts", "default": "./src/interrupt.ts" },
    "./skill": { "types": "./src/skill.ts", "default": "./src/skill.ts" },
    "./control": { "types": "./src/control.ts", "default": "./src/control.ts" },
    "./response-format": { "types": "./src/response-format.ts", "default": "./src/response-format.ts" },
    "./oauth": { "types": "./src/oauth.ts", "default": "./src/oauth.ts" },
    "./workflow": { "types": "./src/workflow.ts", "default": "./src/workflow.ts" },
    "./goal": { "types": "./src/goal.ts", "default": "./src/goal.ts" },
    "./scheduled-job": { "types": "./src/scheduled-job.ts", "default": "./src/scheduled-job.ts" },
    "./server": { "types": "./src/server.ts", "default": "./src/server.ts" },
    "./provider": { "types": "./src/provider.ts", "default": "./src/provider.ts" },
    "./visualization": { "types": "./src/visualization.ts", "default": "./src/visualization.ts" },
    "./tool-display": { "types": "./src/tool-display.ts", "default": "./src/tool-display.ts" },
    "./wire": { "types": "./src/wire.ts", "default": "./src/wire.ts" }
  },
  "dependencies": {
    "@capekai/tool": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/add-js-extensions.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "bun-types": "^1.3.9",
    "typescript": "^5.7.2"
  }
}
