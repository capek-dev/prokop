    "./preconfig": { "types": "./src/preconfig.ts", "default": "./src/preconfig.ts" },
    "./model": { "types": "./src/model.ts", "default": "./src/model.ts" },
    "./workspace": { "types": "./src/workspace.ts", "default": "./src/workspace.ts" },
    "./permission": { "types": "./src/permission.ts", "default": "./src/permission.ts" },
    "./interrupt": { "types": "./src/interrupt.ts", "default": "./src/interrupt.ts" },
    "./skill": { "types": "./src/skill.ts", "default": "./src/skill.ts" },
    "./control": { "types": "./src/control.ts", "default": "./src/control.ts" },
    "./response-format": { "types": "./src/response-format.ts", "default": "./src/response-format.ts" },
    "./oauth": { "types": "./src/oauth.ts", "default": "./src/oauth.ts" },
